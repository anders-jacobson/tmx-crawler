{
  "source": {
    "baseUrl": "https://www.getinge.com/int/",
    "lang": "en"
  },
  "target": {
    "baseUrl": "https://www.getinge.com/de/",
    "lang": "de"
  },
  "discovery": {
    "sitemapUrl": "auto",
    "maxPages": 500,
    "maxDepth": 6,
    "exclude": [
      "\\.(pdf|jpe?g|png|gif|svg|webp|ico|zip|gz|docx?|xlsx?|pptx?|mp4|mp3|mov|avi|xml|json|txt|css|js)(\\?.*)?$",
      "/search/?$",
      "/link/[0-9a-f]+\\.aspx",
      "/company/",
      "/news/",
      "/settings/"
    ],
    "order": "shallow-first"
  },
  "http": {
    "userAgent": "SiteTmxAligner/1.0 (+https://github.com/anders-jacobson/tmx-crawler; localization TM builder)",
    "delayMs": 500,
    "concurrency": 2,
    "timeoutMs": 20000,
    "retries": 3,
    "respectRobotsTxt": true
  },
  "extraction": {
    "contentRoot": ".Banner-main, main#Main",
    "anchors": [
      {
        "selector": "[id^=\"block-\"]"
      },
      {
        "selector": "[data-item-id]",
        "attribute": "data-item-id",
        "pattern": "(\\d+)$"
      },
      {
        "selector": "[id^=\"itm\"]",
        "attribute": "id",
        "pattern": "(\\d+)$"
      }
    ],
    "pageIdentity": {
      "id": {
        "selector": "meta[name=\"pageid\"]",
        "attribute": "content"
      },
      "contentLanguage": {
        "selector": "meta[name=\"pagecontent\"]",
        "attribute": "content",
        "pattern": "_([a-z]{2}(?:-[a-z]{2,4})?)_\\d+$"
      },
      "required": false
    },
    "extraNoiseSelectors": [
      ".Modal",
      ".TeaserSlider-nav",
      ".NewsListBlock-wrapper",
      "[id^=\"block-\"]:has(.NewsListBlock-wrapper)",
      ".EventList-wrapper",
      ".ColorTeaser",
      ".ProductList",
      ".ProductList-item",
      ".Article-teaser"
    ],
    "checkHtmlLang": true
  },
  "alignment": {
    "mapping": "auto",
    "mode": "strict",
    "minWords": 4,
    "maxWords": 80,
    "minLengthRatio": 0.5,
    "maxLengthRatio": 2.5,
    "requireNumberMatch": true,
    "allowTargetRedirects": false,
    "requireProtectedTokens": true,
    "checkTargetLanguage": true
  },
  "output": {
    "file": "output/getinge-en-de.tmx",
    "reportFile": "output/getinge-en-de.report.json",
    "includeProvenance": true,
    "rejectedSamplesPerReason": 50
  },
  "logging": {
    "level": "info"
  }
}
