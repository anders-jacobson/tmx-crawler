{
  "source": {
    "baseUrl": "https://www.getinge.com/int/",
    "lang": "en"
  },
  "target": {
    "baseUrl": "https://www.getinge.com/de/",
    "lang": "de"
  },
  "discovery": {
    "sitemapUrl": "auto",
    "maxPages": 500,
    "maxDepth": 6,
    "exclude": [
      "\\.(pdf|jpe?g|png|gif|svg|webp|ico|zip|gz|docx?|xlsx?|pptx?|mp4|mp3|mov|avi|xml|json|txt|css|js)(\\?.*)?$",
      "/search/?$",
      "/link/[0-9a-f]+\\.aspx",
      "/company/",
      "/news/",
      "/settings/",
      "/insights/events/"
    ],
    "order": "shallow-first"
  },
  "http": {
    "userAgent": "SiteTmxAligner/1.0 (+https://github.com/anders-jacobson/tmx-crawler; localization TM builder)",
    "delayMs": 500,
    "concurrency": 2,
    "timeoutMs": 20000,
    "retries": 3,
    "respectRobotsTxt": true
  },
  "extraction": {
    "contentRoot": ".Banner-main, main#Main",
    "blockSelector": "h1, h2, h3, h4, p, li",
    "anchors": [
      {
        "selector": "[id^=\"block-\"]"
      },
      {
        "selector": "[data-item-id]",
        "attribute": "data-item-id",
        "pattern": "(\\d+)$"
      },
      {
        "selector": "[id^=\"itm\"]",
        "attribute": "id",
        "pattern": "(\\d+)$"
      }
    ],
    "pageIdentity": {
      "id": {
        "selector": "meta[name=\"pageid\"]",
        "attribute": "content"
      },
      "contentLanguage": {
        "selector": "meta[name=\"pagecontent\"]",
        "attribute": "content",
        "pattern": "_([a-z]{2}(?:-[a-z]{2,4})?)_\\d+$"
      },
      "required": false
    },
    "extraNoiseSelectors": [
      ".Modal",
      ".TeaserSlider-nav",
      ".NewsListBlock-wrapper",
      "[id^=\"block-\"]:has(.NewsListBlock-wrapper)",
      ".EventList-wrapper",
      ".ColorTeaser",
      ".ProductList",
      ".ProductList-item",
      ".Article-teaser",
      ".CallToAction",
      ".Button",
      "a.Link",
      ".Tabs-link",
      ".DownloadList-link",
      ".FormSubmitButton",
      ".Document",
      "[id^=\"accordionDocsPanel\"]",
      "h2.Accordion-heading:has([id^=\"accordionDocsHeader\"])"
    ],
    "checkHtmlLang": true
  },
  "alignment": {
    "mapping": "auto",
    "mode": "strict",
    "minWords": 4,
    "maxWords": 80,
    "minWordsByTag": {
      "h1": 1,
      "h2": 1,
      "h3": 1,
      "h4": 1
    },
    "minLengthRatio": 0.5,
    "maxLengthRatio": 2.5,
    "lengthRatioMinWords": 4,
    "requireNumberMatch": true,
    "allowTargetRedirects": false,
    "requireProtectedTokens": true,
    "checkTargetLanguage": true,
    "structureGuard": "prefix",
    "checkCharacters": true,
    "minVariantSimilarity": 0.4,
    "tokenEquivalents": {
      "de": {
        "CSSD": ["AEMP", "AEMPs", "ZSVA"],
        "AI": ["KI"],
        "OR": ["OP", "OPs"],
        "ICU": ["ITS", "IPS"],
        "GDPR": ["DSGVO"],
        "MAP": ["MAD"],
        "CI": ["HI"],
        "CO": ["HZV"],
        "CVP": ["ZVD"],
        "HR": ["HF"],
        "PR": ["PF"],
        "NGO": ["NRO"],
        "LTSF": ["NTSF", "NTDF"],
        "CABG": ["Bypass", "ACVB"],
        "CAD": ["KHK"],
        "eLearnings": ["E-Learning", "E-Learnings"]
      }
    },
    "suppressPairs": [
      {
        "source": "ISOPRIME isolator",
        "target": "Solutions for Sterility Testing",
        "note": "German page: headings in a different order and in English – /products/isoprime-isolators/"
      },
      {
        "source": "Solutions for Sterility Testing",
        "target": "ISOPRIME isolator",
        "note": "German page: headings in a different order and in English – /products/isoprime-isolators/"
      },
      {
        "source": "Isolators to secure contamination prevention",
        "target": "Optimized for common aseptic applications",
        "note": "German page: English heading in this position – /products/isoprime-isolators/"
      },
      {
        "source": "Wash racks for bioreactors",
        "target": "Sicherer, ergonomischer Transport und Lagerung",
        "note": "German page: headings in a different order – /products/loading-equipment-for-getinge-lancer-ultima-laboratory-washers/"
      },
      {
        "source": "Safe, ergonomic transport and storage",
        "target": "Spezieller Einsatz für Reinigungswagen",
        "note": "German page: headings in a different order – /products/loading-equipment-for-getinge-lancer-ultima-laboratory-washers/"
      },
      {
        "source": "ED-Flow",
        "target": "Räumliche Barriere zwischen unreiner und reiner Seite.",
        "note": "German page: different content in this position – /products/ed-flow/"
      },
      {
        "source": "A culture of innovation focused on the surgeon and dedicated to patients",
        "target": "Autofluoreszenz und Fluoreszenzbildgebung",
        "note": "German page: different content in this position – /products-and-solutions/operating-room/or-equipment/fluorescence-imaging/"
      },
      {
        "source": "No two breaths are the same",
        "target": "NAVA: Die stille Revolution in der Intensivbeatmung",
        "note": "German page: different heading in this position – /insights/updates/healthcare/nava--the-silent-revolution-in-intensive-care-ventilation/"
      },
      {
        "source": "Challenges in measuring transpulmonary pressure",
        "target": "Lungenbelastung reduzieren und personalisiert beatmen",
        "note": "German page: different heading in this position – /insights/updates/healthcare/transpulmonary-pressure-monitoring-made-easy/"
      }
    ]
  },
  "output": {
    "file": "output/getinge-en-de.tmx",
    "reportFile": "output/getinge-en-de.report.json",
    "includeProvenance": true,
    "rejectedSamplesPerReason": 50
  },
  "logging": {
    "level": "info"
  }
}
